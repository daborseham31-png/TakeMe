# Copy this file to .env (project root) and set this to wherever your
# server/ backend is running (see server/.env.example to start it).
# Restart with `npx expo start -c` after changing this file.
#
# You're running on a REAL PHONE, so "localhost" will NOT work — the phone
# would look for the server on itself, not on your computer. Use your
# computer's LAN IP instead, and make sure the phone and computer are on
# the same Wi-Fi network:
#
#   1. Find your computer's LAN IP:
#        Windows:      ipconfig            (look for "IPv4 Address")
#        macOS/Linux:  ifconfig | grep inet
#   2. EXPO_PUBLIC_BACKEND_URL=http://<that-ip>:3001
#
# Other cases:
# - Android emulator (not a real phone): http://10.0.2.2:3001
# - iOS simulator / web (not a real phone): http://localhost:3001
EXPO_PUBLIC_BACKEND_URL=http://192.168.1.23:3001
