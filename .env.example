# Copy this file to .env (project root).
# Restart with `npx expo start -c` after changing this file.
#
# The ID/license scanning backend is the deployed Cloudflare Worker
# (cloudflare-worker/), not a local server — this works the same on a real
# phone, an emulator/simulator, or the web build, with no LAN IP required.
EXPO_PUBLIC_BACKEND_URL=https://takeme-id-reader.yvcstudent4.workers.dev
