{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "web-reset-password",
    "cleanUrls": true,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "**",
        "destination": "/reset-password.html"
      }
    ]
  }
}
