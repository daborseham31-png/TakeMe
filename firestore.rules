// -----------------------------------------------------------------------
// TakeMe Firestore Security Rules
// -----------------------------------------------------------------------
// No rules file existed in this repo before this change — access control
// was previously enforced ONLY on the client (see app/admin/_layout.tsx's
// comment). These rules add real server-side enforcement for the two
// things the admin brief explicitly calls out as unsafe to leave to the
// client alone:
//   1. A user must never be able to set their own role to "admin".
//   2. A user must never be able to approve themselves as a driver.
//
// IMPORTANT — READ BEFORE DEPLOYING:
// This project has no firebase.json/.firebaserc checked in either, which
// means whatever rules are live today were set directly in the Firebase
// console (or are the SDK's insecure defaults) and are NOT visible from
// this repo. Deploying this file will REPLACE those rules. Test every
// screen (signup, booking, chat, roadside help, driver creation, ratings)
// against the Firestore emulator or a staging project before deploying to
// production — see the deployment steps in the final summary.
//
// Everything below intentionally stays close to the app's current
// de-facto behavior (any signed-in user can read/write most collections)
// EXCEPT the specific fields/collections called out in the brief, because
// a full lockdown would require verifying every read/write path in a
// ~60-screen app one by one, which risks silently breaking a working
// feature. Tightening these further is a reasonable follow-up once each
// screen's exact access pattern has been audited.
// -----------------------------------------------------------------------

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Never trust a client-sent "role" field — this reads the CALLER's own
    // stored document, which only an admin write (see below) can set.
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // A driver suspended for repeated booked-trip cancellations (see
    // app/booking/driverViolationsLib.ts's cancellationStanding — a
    // completely separate flag from driverVerificationStatus/accountStatus,
    // an unrelated admin-suspension system) may never publish/create new
    // driver work while suspended. This is deliberately a resilient OR-style
    // check (same reasoning as isAdmin()'s own get() above): if the caller's
    // own users/{uid} doc doesn't exist for some reason, this evaluates to
    // false rather than throwing, since a nonexistent standing can never be
    // "suspended". Applied to CREATE only below — narrow, well-understood
    // field shapes (driverId/employerId always equal request.auth.uid on a
    // legitimate create) rather than every existing update path on these
    // collections, which stays exactly as broad/unaudited as it already was.
    function isDriverSuspended() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get("cancellationStanding", {}).get("suspensionActive", false) == true;
    }

    function unchanged(field) {
      return !(field in request.resource.data) ||
        !(field in resource.data) ||
        request.resource.data[field] == resource.data[field];
    }

    // ---------------------------------------------------------------
    // Driver-rating helpers — shared by driverReviews/{reviewId}'s create
    // rule and users/{userId}'s rating-credit branch below. One passenger
    // rating flow, five booking-like source collections (see
    // app/booking/rideBookingLib.ts, schoolTripsLib.ts, bookings.tsx's
    // submitSchoolRating, roadside-help/roadsideLib.ts, work-errand/
    // workErrandLib.ts — every one of them writes this exact same shape:
    // one driverReviews/{bookingId} doc, a few rating fields on the source
    // booking/application doc, and this same users/{driverId} aggregate
    // credit, all inside one Firestore transaction).
    //
    // Deliberately self-contained — neither function below reads any OTHER
    // document via get()/exists(). Earlier versions of this rule cross-
    // checked the review against its source booking (get() on bookings/
    // schoolBookings/workApplications/errandApplications) and used the
    // int()/double() cast functions for exact arithmetic equality; both
    // repeatedly produced "Missing or insufficient permissions" here and
    // were never fully provable without a live Firestore rules simulator.
    // The booking-ownership/completion/not-already-rated checks are still
    // fully enforced — just client-side, inside each submit*Rating
    // transaction (which re-reads the booking fresh from the server before
    // writing, never trusting its caller's in-memory copy) — the same
    // client-trust boundary this file already accepts elsewhere for
    // transaction-run writes (see the schoolTrips seat-booking comment
    // above). What still IS enforced here, server-side, unconditionally:
    // the caller can only ever be the review's own passenger, can never
    // rate themselves, the rating is a plain 1-5 integer, and a driver's
    // aggregate can only ever move by exactly one valid 1-5 rating with
    // no other field touched.
    // ---------------------------------------------------------------
    function isValidDriverReview(reviewId) {
      let data = request.resource.data;
      // "personal" (as opposed to "personal_ride") IS a real, intentional
      // category value here — NOT a typo to "fix" elsewhere. Weekly
      // Personal Ride occurrences are created by createWeeklyBookings
      // (weeklyBookingLib.ts) with category "personal" and rated through
      // bookings.tsx's submitSchoolRating (the same generic BookingItem
      // rating path School uses — see that function's own comment and
      // bookings.tsx's renderBookingCard: "School and (weekly) personal
      // bookings both drive through the ride navigation screen"). Only
      // ONE-TIME Personal Ride bookings use "personal_ride" (rideBookingLib.ts's
      // submitRideRating). Omitting "personal" here is exactly what made
      // every weekly Personal Ride rating fail with "Missing or
      // insufficient permissions" while one-time ratings kept working.
      return data.category in ["personal_ride", "personal", "school", "roadside", "work", "errands"] &&
        data.bookingId == reviewId &&
        data.passengerId == request.auth.uid &&
        data.driverId is string && data.driverId != "" &&
        data.driverId != request.auth.uid &&
        data.rating is int && data.rating >= 1 && data.rating <= 5;
    }

    function isValidDriverRatingCredit(userId) {
      let oldData = resource.data;
      let newData = request.resource.data;
      let oldCount = oldData.get("ratingCount", 0);
      let oldSum = oldData.get("ratingSum", 0);
      let delta = newData.ratingSum - oldSum;
      return isSignedIn() &&
        request.auth.uid != userId &&
        newData.diff(oldData).affectedKeys()
          .hasOnly(["ratingAverage", "ratingCount", "ratingSum", "updatedAt"]) &&
        newData.ratingCount == oldCount + 1 &&
        delta >= 1 && delta <= 5 &&
        newData.ratingAverage >= 0 && newData.ratingAverage <= 5;
    }

    // Whether THIS bookings/{bookingId} write touches any of the fields a
    // passenger's post-trip rating submission ever sets — see
    // submitRideRating (rideBookingLib.ts) and submitSchoolRating
    // (bookings.tsx), which write this exact field set as one step of the
    // same transaction that creates the matching driverReviews/{bookingId}
    // doc (see isValidDriverReview above). Used below to require every
    // rating-SHAPED write to be a fully valid one, without touching the
    // broad allowance every OTHER personal_ride/school write on this
    // collection still relies on (trip lifecycle, cancellation, etc. — see
    // the "Everything else" comment on match /bookings/{bookingId}).
    // Deliberately keyed off "rating" itself, not "ratingSubmitted" —
    // Roadside Help's confirmCompletion (isValidRoadsideBookingUpdate's own
    // "Customer confirms completion" branch) legitimately sets
    // ratingSubmitted: false / needsPassengerRating: true as part of
    // unlocking rating eligibility, without ever submitting a "rating"
    // field. A real rating submission (submitRideRating/submitSchoolRating/
    // submitRoadsideRating) always writes "rating" itself (see
    // isValidPassengerBookingRatingUpdate's own `newData.rating is int`
    // requirement below), so this still catches every genuine attempt.
    function isRatingLikeBookingUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(["rating", "reviewComment", "ratedAt"]);
    }

    // Personal Ride (rideBookingLib.ts's submitRideRating), legacy School
    // (bookings.tsx's submitSchoolRating), AND Roadside Help
    // (roadside-help/roadsideLib.ts's submitRoadsideRating) all submit
    // their post-trip rating as a plain update on THIS SAME
    // bookings/{bookingId} doc (never a separate collection) — Work/Errand
    // are the only ones that rate on a different collection instead
    // (workApplications/errandApplications — see those match blocks
    // below). Roadside Help ALSO still passes isValidRoadsideBookingUpdate
    // above unchanged (its own rating branch there requires the same
    // shape); this function is layered on in ADDITION, not instead of
    // that, so it must accept the exact same write Roadside already
    // performs. Only the booking's own passenger, only once, only after
    // real completion, and only the rating fields themselves —
    // driverId/passengerId/every other field on the booking stay exactly
    // as they were.
    //
    // "personal" is WEEKLY Personal Ride's real category value (see
    // isValidDriverReview's own comment above) — each day of a weekly
    // booking is its own bookings/{bookingId} doc (a distinct auto-id from
    // createWeeklyBookings, never the shared bookingGroupId), so this
    // already naturally gates per OCCURRENCE, not per weekly series.
    function isValidPassengerBookingRatingUpdate() {
      let oldData = resource.data;
      let newData = request.resource.data;
      return oldData.category in ["personal_ride", "personal", "school", "roadside"] &&
        oldData.passengerId == request.auth.uid &&
        newData.passengerId == oldData.passengerId &&
        newData.driverId == oldData.driverId &&
        (oldData.status == "completed" || oldData.tripStatus == "completed") &&
        oldData.get("ratingSubmitted", false) != true &&
        newData.diff(oldData).affectedKeys().hasOnly([
          "rating", "reviewComment", "ratingSubmitted", "needsPassengerRating",
          "ratedAt", "updatedAt",
        ]) &&
        newData.ratingSubmitted == true &&
        newData.rating is int && newData.rating >= 1 && newData.rating <= 5;
    }

    // Lets a driver's own client (recordDriverCancellationViolation) flip
    // their own cancellationStanding.suspensionActive from false to true
    // when a 5th qualifying cancellation fires — but never the other way,
    // and never touching lastSuspensionLiftedAt (admin-lift-only, see
    // liftDriverCancellationSuspension in app/booking/driverViolationsLib.ts).
    function isValidSelfViolationStandingUpdate(userId) {
      let oldStanding = resource.data.get("cancellationStanding", {});
      let newStanding = request.resource.data.cancellationStanding;
      return isSelf(userId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["cancellationStanding", "updatedAt"]) &&
        (oldStanding.get("suspensionActive", false) == false ||
          newStanding.suspensionActive == true) &&
        oldStanding.get("lastSuspensionLiftedAt", null) ==
          newStanding.get("lastSuspensionLiftedAt", null);
    }

    // Driver NO-SHOW violations (app/booking/driverNoShowLib.ts) — a
    // COMPLETELY SEPARATE system from the driver-cancellation violations
    // above (cancellationViolations). The only self-write a driver can ever
    // make to their own driverViolations/{violationId} doc after it's
    // created is submitting exactly one appeal (submitViolationAppeal): flip
    // status open -> appeal_pending and set appealId, nothing else — never
    // active/resolvedBy/resolvedAt/resolutionNote/driverId, and never a
    // second time once appealId is already set (see the driverId ==
    // resource.data.driverId + appealId-was-null checks below, which also
    // block one driver appealing another driver's violation).
    function isValidSelfNoShowAppealSubmission() {
      let oldData = resource.data;
      let newData = request.resource.data;
      return isSelf(oldData.driverId) &&
        newData.diff(oldData).affectedKeys().hasOnly(["status", "appealId", "updatedAt"]) &&
        oldData.active == true &&
        oldData.appealId == null &&
        oldData.status == "open" &&
        newData.status == "appeal_pending" &&
        newData.appealId is string && newData.appealId.size() > 0;
    }

    // Admin resolution of a no-show violation (approveAppeal/rejectAppeal/
    // confirmManualRefund in driverNoShowLib.ts) — an ALLOWLIST, not a blanket
    // isAdmin() pass. An admin may only ever change the resolution/refund
    // bookkeeping fields; every evidence field describing WHAT happened
    // (driverId, tripId, bookingId, schoolTripId, violationType, category,
    // scheduledAt, gracePeriodEndedAt, passengerIds, passengerCount,
    // routeFrom/To, paymentMethods, paidAmount, currency, description,
    // createdAt) is immutable to everyone once written by the trusted
    // Worker — an admin resolving an appeal must never be able to rewrite
    // the record of what actually happened.
    function isValidAdminNoShowViolationUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return changedKeys.hasOnly([
        "status", "active", "appealId",
        "resolvedAt", "resolvedBy", "resolutionNote",
        "refundStatus", "refundedAt", "refundedBy", "refundReference",
        "updatedAt"
      ]);
    }

    // Become a Driver's license OCR self-submission (app/driver/
    // verify-license.tsx's handleVerify) — the passenger's own client sets
    // isDriver + a pending "ai_verified" status alongside the OCR'd license
    // fields and the languages they picked, merged onto their own
    // users/{uid} doc. This is a NARROW carve-out of the isDriver/
    // driverVerificationStatus lock above (the isSelf(...) && unchanged(...)
    // branch), not a replacement for it: the new status can only ever be
    // "ai_verified" here — never "approved" (that stays admin-only, both via
    // the isAdmin() branch and the create rule above), never "rejected"/
    // "suspended", and role/accountStatus/cancellationStanding can never be
    // touched by this branch since they're simply not in the allowed key
    // list (hasOnly below). A driver whose license just expired re-verifies
    // through this exact same write, so the OLD driverVerificationStatus is
    // deliberately unconstrained — only the NEW value is ever checked.
    function isValidSelfLicenseVerification(userId) {
      let newData = request.resource.data;
      return isSelf(userId) &&
        newData.diff(resource.data).affectedKeys().hasOnly([
          "isDriver", "licenseIsValid", "licenseNumber", "licenseExpiryDate",
          "licenseCategories", "spokenLanguages", "driverVerificationStatus",
          "updatedAt",
        ]) &&
        newData.isDriver == true &&
        newData.licenseIsValid == true &&
        newData.driverVerificationStatus == "ai_verified" &&
        newData.licenseNumber is string &&
        newData.licenseExpiryDate is string &&
        newData.licenseCategories is list &&
        newData.spokenLanguages is list;
    }

    // ---------------------------------------------------------------
    // Roadside Help — helper stage machine (Start Driving -> I've Arrived ->
    // Start Help -> Finish Help -> customer Confirm Completion -> cash-only
    // Confirm Cash Received) plus offer acceptance and cancellation sync.
    // See app/booking/roadside-help/roadsideLib.ts, which is the ONLY
    // client code that ever writes these three collections' post-creation
    // fields — every branch below matches ONE of its transaction write
    // shapes exactly (field-for-field, via hasOnly()), which is what makes
    // "the accepted helper, price, and payment method cannot be changed
    // after acceptance" a real guarantee: those fields simply never appear
    // in any allowed key list once the accept-transition itself has run.
    // ---------------------------------------------------------------
    function isValidRoadsideRequestUpdate() {
      let oldData = resource.data;
      let newData = request.resource.data;
      return (
        // Accept — the request owner only, exactly once (oldData.status
        // must still be "open"), choosing exactly one helper + payment
        // method for the rest of this request's life.
        (oldData.passengerId == request.auth.uid &&
          oldData.status == "open" &&
          newData.status == "helper_assigned" &&
          newData.selectedDriverId is string && newData.selectedDriverId != "" &&
          newData.paymentMethod in ["cash", "bit"] &&
          newData.diff(oldData).affectedKeys().hasOnly([
            "status", "selectedOfferId", "selectedDriverId", "selectedDriverName",
            "selectedDriverPhone", "passengerId", "passengerName", "passengerPhone",
            "serviceType", "address", "latitude", "longitude", "agreedPrice",
            "etaMinutes", "estimatedArrivalMinutes", "paymentMethod", "paymentStatus",
            "bookingId", "acceptedAt", "updatedAt",
          ])) ||

        // Helper stage transitions — the accepted helper only, exactly one
        // step forward at a time.
        (oldData.get("selectedDriverId", null) == request.auth.uid &&
          (
            (oldData.status == "helper_assigned" && newData.status == "helper_on_way") ||
            (oldData.status == "helper_on_way" && newData.status == "arrived") ||
            (oldData.status == "arrived" && newData.status == "in_progress") ||
            (oldData.status == "in_progress" && newData.status == "completion_pending")
          ) &&
          newData.diff(oldData).affectedKeys().hasOnly(
            ["status", "driverOnTheWayAt", "arrivedAt", "helpStartedAt", "finishedAt", "updatedAt"]
          )) ||

        // Customer confirms completion — the ONLY path to "completed".
        (oldData.passengerId == request.auth.uid &&
          oldData.status == "completion_pending" &&
          newData.status == "completed" &&
          newData.diff(oldData).affectedKeys().hasOnly([
            "status", "paymentStatus", "helpCompleted", "needsPassengerRating",
            "ratingSubmitted", "completedAt", "updatedAt",
          ])) ||

        // Accepted helper confirms cash received — cash method only, only
        // once the customer has already confirmed completion.
        (oldData.get("selectedDriverId", null) == request.auth.uid &&
          oldData.paymentMethod == "cash" &&
          oldData.status == "completed" &&
          oldData.get("paymentStatus", "") == "pending" &&
          newData.paymentStatus == "paid" &&
          newData.diff(oldData).affectedKeys()
            .hasOnly(["paymentStatus", "paidBy", "paidTo", "paidAmount", "paidAt", "updatedAt"])) ||

        // Passenger rates the helper (submitRoadsideRating) — only once,
        // only after the service has actually reached "completed".
        (oldData.passengerId == request.auth.uid &&
          oldData.status == "completed" &&
          oldData.get("ratingSubmitted", false) == false &&
          newData.rating is int && newData.rating >= 1 && newData.rating <= 5 &&
          newData.diff(oldData).affectedKeys().hasOnly(
            ["rating", "reviewComment", "ratingSubmitted", "needsPassengerRating", "ratedAt", "updatedAt"]
          )) ||

        // Customer cancels — cancelRoadsideRequestByPassenger — ONLY while
        // still "open" or "helper_assigned", i.e. before the accepted
        // helper has pressed Start Driving. This is the sole enforcement
        // point that matters once the UI button is gone: even a direct
        // client write past this point is rejected here.
        (oldData.passengerId == request.auth.uid &&
          oldData.status in ["open", "helper_assigned"] &&
          newData.status == "cancelled" &&
          newData.diff(oldData).affectedKeys()
            .hasOnly(["status", "cancelledBy", "cancelledAt", "updatedAt"])) ||

        // Driver cancels — syncCancelledRoadsideRequest, run right after
        // cancelGeneralBooking's own `bookings` write succeeds. Unrestricted
        // by stage (unchanged from before) — this task only tightens the
        // customer's own cancellation window, not the driver's.
        (oldData.get("selectedDriverId", null) == request.auth.uid &&
          newData.status == "cancelled" &&
          newData.diff(oldData).affectedKeys().hasOnly(["status", "updatedAt"]))
      );
    }

    function isValidRoadsideOfferUpdate() {
      let oldData = resource.data;
      let newData = request.resource.data;
      return (
        // The request owner accepts/rejects offers on their own request
        // (acceptOffer, rejectOffer) and later marks the accepted offer
        // completed once they confirm completion — every offer carries its
        // own passengerId (copied at creation), so this needs no
        // cross-collection get().
        (oldData.passengerId == request.auth.uid &&
          newData.diff(oldData).affectedKeys()
            .hasOnly(["status", "paymentStatus", "acceptedAt", "completedAt", "updatedAt"]) &&
          (
            (oldData.status == "pending" && newData.status in ["accepted", "not_selected"]) ||
            (oldData.status == "accepted" && newData.status in ["not_selected", "completed"])
          )) ||
        // The accepted helper confirms cash received on their own offer.
        (oldData.driverId == request.auth.uid &&
          oldData.status == "completed" &&
          oldData.get("paymentStatus", "") == "pending" &&
          newData.paymentStatus == "paid" &&
          newData.diff(oldData).affectedKeys().hasOnly(["paymentStatus", "paidAt", "updatedAt"])) ||
        // Passenger rates the helper (submitRoadsideRating) — mirrors the
        // matching rating branch on roadsideRequests above; this is the
        // SAME rating being echoed onto the offer doc, once, only after
        // completion.
        (oldData.passengerId == request.auth.uid &&
          oldData.status == "completed" &&
          oldData.get("ratingSubmitted", false) == false &&
          newData.rating is int && newData.rating >= 1 && newData.rating <= 5 &&
          newData.diff(oldData).affectedKeys()
            .hasOnly(["rating", "reviewComment", "ratingSubmitted", "ratedAt", "updatedAt"]))
      );
    }

    function isValidRoadsideBookingUpdate() {
      let oldData = resource.data;
      let newData = request.resource.data;
      return (
        // Helper stage transitions.
        (oldData.driverId == request.auth.uid &&
          (
            (oldData.tripStatus == "booked" && newData.tripStatus == "driver_on_way") ||
            (oldData.tripStatus == "driver_on_way" && newData.tripStatus == "arrived_pickup") ||
            (oldData.tripStatus == "arrived_pickup" && newData.tripStatus == "in_progress") ||
            (oldData.tripStatus == "in_progress" && newData.tripStatus == "completion_pending")
          ) &&
          newData.diff(oldData).affectedKeys()
            .hasOnly(["tripStatus", "trackingEnabled", "updatedAt"])) ||

        // Customer confirms completion.
        (oldData.passengerId == request.auth.uid &&
          oldData.tripStatus == "completion_pending" &&
          newData.tripStatus == "completed" &&
          newData.diff(oldData).affectedKeys().hasOnly([
            "status", "tripStatus", "paymentStatus", "helpCompleted",
            "needsPassengerRating", "ratingSubmitted", "completedAt", "updatedAt",
          ])) ||

        // Accepted helper confirms cash received.
        (oldData.driverId == request.auth.uid &&
          oldData.paymentMethod == "cash" &&
          oldData.status == "completed" &&
          oldData.get("paymentStatus", "") == "pending" &&
          newData.paymentStatus == "paid" &&
          newData.diff(oldData).affectedKeys()
            .hasOnly(["paymentStatus", "paidAmount", "paidAt", "updatedAt"])) ||

        // Passenger rates the helper (submitRoadsideRating).
        (oldData.passengerId == request.auth.uid &&
          oldData.status == "completed" &&
          oldData.get("ratingSubmitted", false) == false &&
          newData.rating is int && newData.rating >= 1 && newData.rating <= 5 &&
          newData.diff(oldData).affectedKeys().hasOnly(
            ["rating", "reviewComment", "ratingSubmitted", "needsPassengerRating", "ratedAt", "updatedAt"]
          )) ||

        // Customer cancels — cancelRoadsideRequestByPassenger — ONLY while
        // tripStatus is still "booked" (before Start Driving). Same cutoff
        // as isValidRoadsideRequestUpdate's matching branch above.
        (oldData.passengerId == request.auth.uid &&
          oldData.tripStatus == "booked" &&
          newData.status == "cancelled" &&
          newData.diff(oldData).affectedKeys().hasOnly(["status", "updatedAt"])) ||

        // Driver cancels (cancelGeneralBooking — shared across every
        // category, see the `bookings` match block's own comment below).
        // Unrestricted by stage, unchanged from before.
        (oldData.driverId == request.auth.uid &&
          newData.status == "cancelled" &&
          newData.diff(oldData).affectedKeys().hasOnly(["status", "updatedAt"]))
      );
    }

    // ---------------------------------------------------------------
    // users/{userId}
    // ---------------------------------------------------------------
    match /users/{userId} {
      // Broad authenticated read: driver search, chat search, profile
      // lookups, reviews, and the admin screens all need to read other
      // users' profiles today.
      allow read: if isSignedIn();

      // A brand-new signup writes its own doc once, and can never write
      // itself in as an admin or as an already-approved driver.
      allow create: if isSelf(userId)
        && request.resource.data.role in ["passenger", "driver"]
        && request.resource.data.get("driverVerificationStatus", "pending_admin_review")
             != "approved";

      // A user may update their own profile fields, but never their own
      // role, verification status, or account status — those are
      // admin-only (see the isAdmin() branch below). An admin may update
      // any user doc, including those fields.
      allow update: if isAdmin() || (
        isSelf(userId) &&
        unchanged("role") &&
        unchanged("isDriver") &&
        unchanged("driverVerificationStatus") &&
        unchanged("accountStatus") &&
        unchanged("cancellationStanding")
      ) || (
        // A passenger who just rated THIS user as their driver credits
        // exactly one new rating onto the running-average fields — see
        // isValidDriverRatingCredit above and every submit*Rating function
        // across app/booking/ (rideBookingLib.ts, schoolTripsLib.ts,
        // bookings.tsx, roadside-help/roadsideLib.ts, work-errand/
        // workErrandLib.ts), which all write here as one step of the same
        // rating transaction that creates the matching driverReviews/
        // {bookingId} doc and marks the booking rated. Never touches
        // name/role/phone/verification/anything else about the profile.
        isValidDriverRatingCredit(userId)
      ) || (
        // recordDriverCancellationViolation (app/booking/driverViolationsLib.ts)
        // runs as the driver's OWN client — this is the one narrow path that
        // lets a driver's session flip their own cancellationStanding from
        // not-suspended to suspended when they hit the 5th violation. It can
        // never go the other way (a driver can never self-lift), and can
        // never touch lastSuspensionLiftedAt, which only
        // liftDriverCancellationSuspension (admin-only call site) sets.
        isValidSelfViolationStandingUpdate(userId)
      ) || (
        isValidSelfLicenseVerification(userId)
      );

      allow delete: if isAdmin() && request.auth.uid != userId;

      // users/{userId}/savedFormValues/{docId} — a driver's own remembered
      // car model/color/plate/price suggestions (see
      // app/driver/create/savedFormValuesLib.ts). Strictly private: only
      // the owning driver (never another signed-in user, never an
      // unauthenticated request) can read or write it — nothing here is
      // ever shown to anyone else.
      match /savedFormValues/{docId} {
        allow read, write: if isSelf(userId);
      }

      // users/{userId}/cancellationViolations/{violationId} — one doc per
      // driver-initiated cancellation of an already-booked trip (see
      // app/booking/driverViolationsLib.ts). The driver's own client creates
      // it at cancel time (never adminExcused:true — that flag can only ever
      // be flipped by an admin, via excuseDriverCancellationViolation or by
      // approveCancellationViolationAppeal below).
      match /cancellationViolations/{violationId} {
        allow read: if isAdmin() || isSelf(userId);
        allow create: if isSelf(userId) &&
          request.resource.data.driverId == userId &&
          request.resource.data.adminExcused == false;
        // isAdmin() stays a blanket allow (excuse/approve/reject all write
        // different field sets here — narrowing it would just re-derive the
        // same trust boundary this codebase already gives every OTHER admin
        // action). The second branch is the driver's own narrow self-write:
        // submitting exactly one appeal (submitViolationAppeal, called with
        // violationSource:"cancellationViolations") — same shape as
        // isValidSelfNoShowAppealSubmission() below, for the SAME reason
        // (driver must never be able to alter their own violation beyond
        // flipping it into "appeal_pending").
        allow update: if isAdmin() || isValidSelfCancellationAppealSubmission(userId);
        allow delete: if false;
      }
    }

    // Mirrors isValidSelfNoShowAppealSubmission() below field-for-field,
    // targeting users/{userId}/cancellationViolations/{violationId} instead
    // of driverViolations/{violationId} — see submitViolationAppeal
    // (driverNoShowLib.ts), which writes this exact transition for both
    // violation sources.
    function isValidSelfCancellationAppealSubmission(userId) {
      let oldData = resource.data;
      let newData = request.resource.data;
      return isSelf(userId) &&
        oldData.driverId == userId &&
        newData.diff(oldData).affectedKeys().hasOnly(["status", "appealId", "updatedAt"]) &&
        oldData.active == true &&
        oldData.appealId == null &&
        oldData.status == "open" &&
        newData.status == "appeal_pending" &&
        newData.appealId is string && newData.appealId.size() > 0;
    }

    // ---------------------------------------------------------------
    // Admin-only collections
    // ---------------------------------------------------------------
    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.adminId == request.auth.uid;
      allow update, delete: if false;
    }

    match /adminReports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && resource.data.reporterId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Admin resolution of an appeal (approveAppeal/rejectAppeal) — an
    // ALLOWLIST mirroring isValidAdminNoShowViolationUpdate() above. An
    // admin may only ever touch the review/decision fields; the driver's
    // own submitted evidence (violationId, driverId, tripId, reasonCategory,
    // explanation, evidenceUrls, submittedAt, createdAt) is immutable once
    // filed — an admin resolving an appeal must never be able to alter what
    // the driver actually said.
    function isValidAdminNoShowAppealUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return changedKeys.hasOnly(["status", "reviewedAt", "reviewedBy", "adminDecisionNote", "updatedAt"]);
    }

    // ---------------------------------------------------------------
    // Driver NO-SHOW violations + appeals (app/booking/driverNoShowLib.ts,
    // cloudflare-worker/src/noShowDetection.ts) — a COMPLETELY SEPARATE
    // system from users/{userId}/cancellationViolations above. The Cloudflare
    // Worker's scheduled cron is the ONLY writer that may ever CREATE a
    // violation, set tripStatus to driver_no_show, update affected booking
    // records, or create the initial notifications — it authenticates as a
    // Google service account via a signed OAuth2 token, not a Firebase Auth
    // session, so those Firestore REST calls are authorized by IAM, not
    // these rules, and bypass this `match` block entirely (same precedent as
    // this project's existing schoolChildren.ts Worker routes). No Firebase
    // Auth session — driver, admin, or otherwise — may ever create a
    // driverViolations document; `allow create: if false` below is
    // deliberate, not a placeholder. The mobile app's opportunistic check
    // (runClientSideNoShowCheck was removed) may only ever read/subscribe —
    // it must never attempt to write here.
    match /driverViolations/{violationId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.driverId == request.auth.uid);
      allow create: if false;
      allow update: if (isAdmin() && isValidAdminNoShowViolationUpdate()) || isValidSelfNoShowAppealSubmission();
      allow delete: if false;
    }

    // One appeal doc shape shared by BOTH violation systems (see
    // ViolationSource in driverNoShowLib.ts) — violationSource tells this
    // rule (and the admin review screens) which violation document the
    // appeal is actually about, since a no-show violation lives at
    // driverViolations/{violationId} but a cancellation violation lives at
    // users/{driverId}/cancellationViolations/{violationId} (needs its own
    // driverId path segment, which is why the target-lookup below branches).
    function violationAppealTargetIsValid() {
      return request.resource.data.violationSource == "cancellationViolations"
        ? (
            get(/databases/$(database)/documents/users/$(request.auth.uid)/cancellationViolations/$(request.resource.data.violationId))
              .data.driverId == request.auth.uid &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)/cancellationViolations/$(request.resource.data.violationId))
              .data.appealId == null
          )
        : (
            get(/databases/$(database)/documents/driverViolations/$(request.resource.data.violationId))
              .data.driverId == request.auth.uid &&
            get(/databases/$(database)/documents/driverViolations/$(request.resource.data.violationId))
              .data.appealId == null
          );
    }

    match /violationAppeals/{appealId} {
      // A driver may create exactly one appeal for their OWN active
      // violation (of either system) that doesn't already have one — the
      // get() inside violationAppealTargetIsValid() reads the referenced
      // violation doc to enforce both "not someone else's violation" (test
      // case 10) and "not a second appeal" (test case 11) at the database
      // layer, not just in app code.
      allow create: if isSignedIn() &&
        request.resource.data.driverId == request.auth.uid &&
        request.resource.data.status == "pending" &&
        request.resource.data.reviewedBy == null &&
        request.resource.data.reviewedAt == null &&
        request.resource.data.explanation is string &&
        request.resource.data.explanation.size() > 0 &&
        request.resource.data.violationSource in ["driverViolations", "cancellationViolations"] &&
        violationAppealTargetIsValid();
      allow read: if isAdmin() || (isSignedIn() && resource.data.driverId == request.auth.uid);
      // Only resolution fields ever change here, and only an admin changes
      // them (approveAppeal/rejectAppeal, or
      // approveCancellationViolationAppeal/rejectCancellationViolationAppeal,
      // in driverNoShowLib.ts/driverViolationsLib.ts) — a driver can never
      // edit their own submitted appeal (matches the product spec's "driver
      // must not be able to edit the violation itself", and by extension,
      // not the appeal record either, once submitted). Same allowlist for
      // both violation sources — the fields an admin resolution touches
      // never differ between them.
      allow update: if isAdmin() && isValidAdminNoShowAppealUpdate();
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // Everything else the app already uses — authenticated read/write,
    // matching today's effective (rules-free) behavior. See the note at
    // the top of this file about tightening these per-collection later.
    //
    // bookings / driverRoutes / workJobs / errandJobs specifically were
    // re-audited for the cancellation-enforcement follow-up (write call
    // sites grepped across the whole app) and deliberately LEFT BROAD here
    // — narrowing them is a real blocker, not an oversight:
    //   - driverRoutes/workJobs/errandJobs must stay broadly READABLE: any
    //     signed-in user browsing/searching for a ride or job (driverresults.tsx,
    //     work-errand's browse screens) reads OTHER users' listings, never
    //     just their own.
    //   - Both collections also take legitimate WRITES from a passenger who
    //     doesn't own the listing (confirmed: cancelGeneralBooking/
    //     cancelApplication restore seat counts on a driverRoutes/workJobs
    //     doc the CANCELLING PASSENGER doesn't own) — an ownership-only
    //     (driverId/employerId-only) rule would break that seat-restore path.
    //     Scoping this safely needs the exact field-transition shape of
    //     EVERY write (creation in weeklyBookingLib.ts, RideForm.tsx,
    //     driver/create/work.tsx, driver/create/errand.tsx; the full booking/
    //     accept/start/finish lifecycle in ride-navigation.tsx and admin
    //     overrides in admin/adminRidesLib.ts / adminBookingsLib.ts), none of
    //     which has been audited here — left unchanged rather than guessed.
    //   - bookings similarly takes writes from ride-navigation.tsx (trip
    //     lifecycle), ride-payment.tsx, roadside-help/payment.tsx, and
    //     admin/bookings/[id].tsx, none of which has been audited here.
    // The 2-hour/5-hour cancellation window itself is NOT enforced here
    // either way — Firestore Rules cannot reliably parse this app's
    // "YYYY-MM-DD"/"HH:mm" string fields (inconsistent field names per
    // category, no rules-language date arithmetic) — that check lives
    // exclusively in the data layer (cancelRideBooking/cancelGeneralBooking/
    // cancelApplication/cancelSchoolBooking/cancelSchoolTrip), which now all
    // re-read the current document fresh before acting on it.
    // ---------------------------------------------------------------
    match /bookings/{bookingId} {
      allow read: if isSignedIn();

      // Creation stays broad for every category (see the comment above) —
      // acceptOffer's own transaction (the passenger's client) creates the
      // roadside booking doc this way too.
      allow create: if isSignedIn();

      // Roadside Help (category == "roadside") is the one category with a
      // real, audited field-transition shape post-creation — see
      // isValidRoadsideBookingUpdate above. Every other category keeps
      // today's broad behavior unchanged (see the comment above on why).
      // Admin overrides (adminBookingsLib.ts's cancelBooking, etc.) keep
      // working exactly as before, for every category including roadside.
      //
      // ADDITIONALLY (regardless of category): any write that touches a
      // rating field (isRatingLikeBookingUpdate) must ALSO be a fully valid
      // passenger rating update (isValidPassengerBookingRatingUpdate) — see
      // that function's own comment. This is layered on with `&&`, not
      // folded into the broad OR above, specifically so it can never be
      // satisfied merely by "category != roadside": a passenger can submit
      // their OWN rating on a completed Personal Ride/School booking, but
      // can never use a rating-shaped write to change driverId/passengerId
      // or any other field, rate a booking they don't own, rate one that
      // isn't completed, or rate the same booking twice. Admin never needs
      // to touch these fields (confirmed: adminBookingsLib.ts never writes
      // rating/reviewComment/ratingSubmitted/ratedAt), so this applies to
      // isAdmin() too, with no known write path affected.
      allow update: if isSignedIn() &&
        (isAdmin() || resource.data.get("category", "") != "roadside" || isValidRoadsideBookingUpdate()) &&
        (!isRatingLikeBookingUpdate() || isValidPassengerBookingRatingUpdate());

      // Nothing in this app ever deletes a booking doc (cancellation is a
      // status update, never a delete) — denying it here is a pure
      // tightening with no known write path affected.
      allow delete: if false;
    }

    match /driverRoutes/{routeId} {
      allow read: if isSignedIn();
      // A suspended driver may not publish a new ride/weekly trip listing —
      // see isDriverSuspended() above. update/delete stay exactly as broad
      // as before (see the comment above on why — cancellation flows
      // restore seats on routes the calling passenger doesn't own).
      allow create: if isSignedIn() && !isDriverSuspended();
      allow update, delete: if isSignedIn();
    }

    match /workJobs/{jobId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !isDriverSuspended();
      allow update, delete: if isSignedIn();
    }

    match /errandJobs/{errandId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !isDriverSuspended();
      allow update, delete: if isSignedIn();
    }

    // workApplications/errandApplications, unlike the four collections
    // above, WERE fully auditable: createApplication (workErrandLib.ts) is
    // the ONLY place either collection is created (grepped across the whole
    // app — driver/create/work.tsx, driver/create/errand.tsx, and every
    // work-errand screen only ever call into workErrandLib.ts's exported
    // functions, never addDoc/updateDoc these collections directly), and
    // every one of accept/reject/confirmPayment/start/arrive/finish/pay/
    // rate/cancel only ever touches status/payment/rating/timestamp fields
    // — never applicantId/employerId (work) or passengerId/driverId
    // (errand), which are set once at creation and never reassigned. That
    // makes a plain ownership check (never a full field-transition
    // validation) safe: only the applicant/customer or the employer/driver
    // on THIS SPECIFIC application may read or write it — never an
    // unrelated third signed-in user, which is what the previous
    // `if isSignedIn()` actually allowed.
    match /workApplications/{applicationId} {
      allow read: if isAdmin() || (isSignedIn() &&
        (resource.data.applicantId == request.auth.uid ||
          resource.data.employerId == request.auth.uid));

      // status must start "pending" — the same value createApplication
      // (workErrandLib.ts) always writes — so a requester can never create
      // an application that skips the employer's own accept/reject step
      // (e.g. self-creating with status "accepted"). Every OTHER field
      // (including the new pickupLocation.area/address/latitude/longitude
      // this feature adds) stays unrestricted here, same as before — this
      // collection has never had a full field-transition allowlist (see the
      // comment above this match block) because createApplication is
      // audited as the sole writer; this one addition closes the one gap
      // that mattered for "a requester cannot alter... status... while
      // submitting the location" (this feature's own acceptance test).
      allow create: if isSignedIn() &&
        request.resource.data.applicantId == request.auth.uid &&
        request.resource.data.status == "pending";

      allow update: if isSignedIn() &&
        (resource.data.applicantId == request.auth.uid ||
          resource.data.employerId == request.auth.uid);

      allow delete: if false;
    }

    match /errandApplications/{applicationId} {
      allow read: if isAdmin() || (isSignedIn() &&
        (resource.data.passengerId == request.auth.uid ||
          resource.data.driverId == request.auth.uid));

      // Same reasoning as workApplications' own create rule above.
      allow create: if isSignedIn() &&
        request.resource.data.passengerId == request.auth.uid &&
        request.resource.data.status == "pending";

      allow update: if isSignedIn() &&
        (resource.data.passengerId == request.auth.uid ||
          resource.data.driverId == request.auth.uid);

      allow delete: if false;
    }

    match /roadsideRequests/{requestId} {
      // Broad authenticated read: nearby drivers browse open requests
      // (Help Requests screen), and sendDriverOffer reads a request that
      // doesn't belong to the calling driver to copy its passenger info
      // onto a new offer.
      allow read: if isSignedIn();

      allow create: if isSignedIn() && request.resource.data.passengerId == request.auth.uid;

      allow update: if isSignedIn() && (isAdmin() || isValidRoadsideRequestUpdate());

      allow delete: if false;
    }

    match /roadsideOffers/{offerId} {
      allow read: if isSignedIn();

      // A suspended driver may not send a new Roadside Help offer — see
      // isDriverSuspended() above.
      allow create: if isSignedIn() &&
        !isDriverSuspended() &&
        request.resource.data.driverId == request.auth.uid &&
        request.resource.data.status == "pending";

      allow update: if isSignedIn() && (isAdmin() || isValidRoadsideOfferUpdate());

      allow delete: if false;
    }

    // See isValidDriverReview above — reviewId must equal the bookingId
    // being rated (this is what makes a duplicate rating attempt a `create`
    // on an already-existing doc, rejected before any field is even
    // inspected), the review must be for a real completed booking the
    // caller actually owns, and it's immutable once created.
    match /driverReviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidDriverReview(reviewId);
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn();

      // Left as broad "any signed-in user" for receiverId, matching this
      // collection's actual de-facto use everywhere in the app (a driver
      // notifying their passenger, a passenger notifying their driver, ... —
      // "notify someone else" IS the whole point of this collection, not a
      // gap). The one real spoofing risk closed here: a caller can never
      // forge a DIFFERENT sender identity than their own auth uid, and can
      // never mark a notification as already pushed (pushSent is
      // exclusively set by the send-push Cloud Function after it actually
      // sends one — see functions/index.js's sendPushForNotification).
      allow create: if isSignedIn() &&
        (!("senderId" in request.resource.data) || request.resource.data.senderId == null ||
          request.resource.data.senderId == request.auth.uid) &&
        (!("pushSent" in request.resource.data) || request.resource.data.pushSent == false);

      allow update, delete: if isSignedIn();
    }

    match /driverNotifications/{notificationId} {
      allow read, write: if isSignedIn();
    }

    match /conversations/{conversationId} {
      allow read, write: if isSignedIn();

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    // ---------------------------------------------------------------
    // School Trips upgrade (see AGENTS.md) — schoolTrips / schoolBookings /
    // rideRequests. Unlike the wide-open collections above, these three are
    // given real per-owner enforcement from the start, per the brief's own
    // requirement: "A driver can only modify their own trips", "a driver
    // cannot insecurely manipulate availableSeats", "a user can only create
    // and read their own bookings", "a user can only create or cancel their
    // own waiting requests".
    // ---------------------------------------------------------------

    match /schoolTrips/{tripId} {
      // Public read (search needs to find any active trip) — never a
      // security-sensitive field on this document.
      allow read: if isSignedIn();

      // A suspended driver may not create a new School Trip listing — see
      // isDriverSuspended() above.
      allow create: if isSignedIn() &&
        !isDriverSuspended() &&
        request.resource.data.driverId == request.auth.uid &&
        request.resource.data.availableSeats == request.resource.data.totalSeats;

      // Legitimate non-owner-agnostic update shapes:
      //   1) The owning driver changes status (e.g. cancelling a leg) and
      //      optionally stamps WHY — cancellationReason is read server-side
      //      by the onSchoolTripCancelled Cloud Function to propagate onto
      //      affected bookings and to build the replacement offer.
      //   2) ANY signed-in user's booking/cancellation transaction moves
      //      availableSeats within [0, totalSeats] and status between
      //      active/full — never any other field (price, driverId, date,
      //      school, ...). This is the client-trust boundary called out in
      //      AGENTS.md #13: booking runs a Firestore transaction from the
      //      passenger's own device, not from a trusted backend. A
      //      Firebase Callable Function performing the seat decrement
      //      server-side (see the deployment notes) would close this
      //      further — tracked as a follow-up, not done here since it
      //      changes the booking transaction's execution model.
      //   3) The owning driver drives the trip-lifecycle (start/arrive/
      //      finish + live GPS) from app/driver/ride-navigation.tsx's
      //      schoolTrips branch — tripStatus only ever moves through the
      //      real tracking states, and `status` is either left alone or
      //      flipped to "completed" (the ONLY status transition this
      //      branch can make; cancelling is still branch 1 only).
      allow update: if isSignedIn() && (
        (
          resource.data.driverId == request.auth.uid &&
          request.resource.data.driverId == resource.data.driverId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "cancellationReason", "updatedAt"])
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["availableSeats", "status", "updatedAt"]) &&
          request.resource.data.availableSeats >= 0 &&
          request.resource.data.availableSeats <= resource.data.totalSeats &&
          request.resource.data.status in ["active", "full", "cancelled"]
        ) ||
        (
          resource.data.driverId == request.auth.uid &&
          request.resource.data.driverId == resource.data.driverId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "tripStatus", "trackingEnabled", "driverLocation", "driverLocationUpdatedAt",
            "driverOnWayAt", "arrivedPickupAt", "completedAt", "finishedByDriver",
            "status", "updatedAt"
          ]) &&
          request.resource.data.tripStatus in
            ["booked", "driver_on_way", "arrived_pickup", "in_progress", "completed"] &&
          (request.resource.data.status == resource.data.status || request.resource.data.status == "completed")
        ) ||
        (
          // The owning driver hides this trip listing from their own My
          // Bookings view only (hideSchoolTrip/"Clear All" — see
          // schoolTripsLib.ts) — a PURE view-hide, never a cancellation:
          // every other field, including `status`, is required unchanged.
          resource.data.driverId == request.auth.uid &&
          request.resource.data.driverId == resource.data.driverId &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["deletedForDriver", "updatedAt"]) &&
          request.resource.data.deletedForDriver == true
        )
      );

      allow delete: if false;
    }

    match /schoolBookings/{bookingId} {
      allow read: if isSignedIn() &&
        (resource.data.passengerId == request.auth.uid || resource.data.driverId == request.auth.uid);

      allow create: if isSignedIn() &&
        request.resource.data.passengerId == request.auth.uid;

      // Eight legitimate update shapes:
      //   1) The booking passenger cancels it — driver/trip/price/seat
      //      fields are immutable after creation, and this can only ever
      //      move status to "cancelled" + expire the passenger's own
      //      verification code (never "verified" — a passenger can never
      //      mark themselves as verified).
      //   2) The owning driver syncs this booking's own tripStatus mirror
      //      (and, once, its rating-eligibility flags) from the SAME trip-
      //      lifecycle transition as the schoolTrips write above — see
      //      ride-navigation.tsx's updateSchoolTripStatus batch sync.
      //      "in_progress" is deliberately NOT a legal value here — see
      //      shape 5 below, the only path allowed to reach it.
      //   3) The booking passenger submits their own post-trip rating.
      //   4) The owning driver records a WRONG code guess (attempt count /
      //      lockout only) — see verifyPassengerCodeAndStartTrip in
      //      schoolTripsLib.ts. Never touches verificationStatus/tripStatus.
      //   5) The owning driver checks the passenger's verification code AND
      //      it MATCHED — the only update shape that may ever move
      //      tripStatus from "arrived_pickup" to "in_progress", and only
      //      together, atomically, with passengerVerified/tripStartedAt all
      //      becoming set in the same write (never independently, never a
      //      second time on a booking that already started). The driver can
      //      never write the code itself, only the check outcome.
      //   6) The booking passenger (parent) accepts a driver-cancellation
      //      replacement offer for THIS (old) booking — see
      //      acceptReplacementOffer in schoolTripsLib.ts. Everything else
      //      about the old booking (seats, price, trip, driver) is frozen;
      //      only the replacement-linkage fields change.
      allow update: if isSignedIn() && (
        (
          resource.data.passengerId == request.auth.uid &&
          request.resource.data.passengerId == resource.data.passengerId &&
          request.resource.data.driverId == resource.data.driverId &&
          request.resource.data.tripId == resource.data.tripId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "verificationStatus", "updatedAt"]) &&
          request.resource.data.status == "cancelled" &&
          request.resource.data.verificationStatus == "expired"
        ) ||
        (
          // Finish Trip stamps completedAt on EACH affected booking (not
          // just the schoolTrips doc) — the rating gate reads
          // completedAtSeconds off the booking itself (bookings.tsx /
          // MySchoolTripsSection.tsx), never off the trip. Omitting
          // "completedAt" here previously denied the whole batch.update in
          // updateSchoolTripStatus (ride-navigation.tsx) the moment a trip
          // had any still-booked passenger — every write in a Firestore
          // batch must independently satisfy this rule, so one denied
          // field in ANY of the affected schoolBookings docs failed the
          // ENTIRE batch, including the schoolTrips write that preceded it.
          resource.data.driverId == request.auth.uid &&
          request.resource.data.driverId == resource.data.driverId &&
          request.resource.data.passengerId == resource.data.passengerId &&
          request.resource.data.tripId == resource.data.tripId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "tripStatus", "status", "finishedByDriver", "needsPassengerRating",
            "ratingSubmitted", "rating", "completedAt", "updatedAt"
          ]) &&
          request.resource.data.tripStatus in
            ["booked", "driver_on_way", "arrived_pickup", "completed"] &&
          (request.resource.data.status == resource.data.status || request.resource.data.status == "completed")
        ) ||
        (
          // Passenger submits their own post-trip rating — only once
          // (resource.data.ratingSubmitted must not already be true) and
          // only once the trip actually completed. Ownership/completion/
          // duplicate-prevention for the review itself is fully verified
          // by isValidDriverReview on the driverReviews/{bookingId} create
          // in the SAME transaction — not re-checked here via exists(),
          // since plain get()/exists() in a security rule reflects the
          // state as it was BEFORE this transaction's own writes, so a
          // review being created in this very transaction would never be
          // visible here yet (that would make this branch impossible to
          // satisfy, not a real safeguard).
          resource.data.passengerId == request.auth.uid &&
          request.resource.data.passengerId == resource.data.passengerId &&
          request.resource.data.driverId == resource.data.driverId &&
          request.resource.data.tripId == resource.data.tripId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ["rating", "reviewComment", "ratingSubmitted", "needsPassengerRating", "ratedAt", "updatedAt"]
          ) &&
          resource.data.get("ratingSubmitted", false) != true &&
          resource.data.tripStatus == "completed" &&
          resource.data.status == "completed" &&
          request.resource.data.ratingSubmitted == true &&
          request.resource.data.rating is int &&
          request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        ) ||
        (
          resource.data.driverId == request.auth.uid &&
          request.resource.data.driverId == resource.data.driverId &&
          request.resource.data.passengerId == resource.data.passengerId &&
          request.resource.data.tripId == resource.data.tripId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["verificationAttempts", "verificationLockedUntil", "updatedAt"])
        ) ||
        (
          resource.data.driverId == request.auth.uid &&
          request.resource.data.driverId == resource.data.driverId &&
          request.resource.data.passengerId == resource.data.passengerId &&
          request.resource.data.tripId == resource.data.tripId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "verificationStatus", "verifiedAt", "verifiedByDriverId", "verificationAttempts",
            "passengerVerified", "passengerVerifiedAt",
            "tripStatus", "tripStartedAt", "tripStartedNotificationSent", "updatedAt"
          ]) &&
          request.resource.data.verificationStatus == "verified" &&
          request.resource.data.verifiedByDriverId == request.auth.uid &&
          request.resource.data.passengerVerified == true &&
          request.resource.data.tripStatus == "in_progress" &&
          resource.data.tripStatus == "arrived_pickup" &&
          (!("passengerVerified" in resource.data) || resource.data.passengerVerified != true) &&
          (!("tripStartedAt" in resource.data) || resource.data.tripStartedAt == null)
        ) ||
        (
          resource.data.passengerId == request.auth.uid &&
          request.resource.data.passengerId == resource.data.passengerId &&
          request.resource.data.driverId == resource.data.driverId &&
          request.resource.data.tripId == resource.data.tripId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "bookingStatus", "replacedByBookingId", "replacementTripId",
            "replacementConfirmedAt", "updatedAt"
          ])
        ) ||
        (
          // 7) The passenger OR the driver hides this booking card from
          //    their own My Bookings view only (hideSchoolBooking/
          //    "Clear All" — see schoolTripsLib.ts) — a PURE view-hide,
          //    never a cancellation: `status`/`tripStatus` are required
          //    unchanged, and each side may only ever set their OWN flag
          //    (deletedForPassenger vs deletedForDriver), never the other
          //    side's copy.
          (
            resource.data.passengerId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["deletedForPassenger", "updatedAt"]) &&
            request.resource.data.deletedForPassenger == true
          ) ||
          (
            resource.data.driverId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["deletedForDriver", "updatedAt"]) &&
            request.resource.data.deletedForDriver == true
          )
        ) ||
        (
          // 8) The owning driver cancels the ENTIRE trip (cancelSchoolTrip)
          //    — this booking is one of possibly several affected by the
          //    same trip cancellation, all updated in the same transaction.
          //    Never restores/reopens anything (there is nothing left to
          //    rebook once the trip itself is cancelled) — only moves
          //    status to "cancelled" and expires the passenger's own
          //    verification code, exactly like the passenger's own
          //    cancellation (shape 1), but tagged cancelledBy "driver" with
          //    the driver's own stated reason preserved for history/the
          //    replacement-offer flow. driver/passenger/trip identity is
          //    frozen, same as every other driver-side shape above.
          resource.data.driverId == request.auth.uid &&
          request.resource.data.driverId == resource.data.driverId &&
          request.resource.data.passengerId == resource.data.passengerId &&
          request.resource.data.tripId == resource.data.tripId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status", "verificationStatus", "bookingStatus", "cancelledBy",
            "cancellationReason", "cancelledAt", "originalTripId", "updatedAt"
          ]) &&
          request.resource.data.status == "cancelled" &&
          request.resource.data.verificationStatus == "expired" &&
          request.resource.data.cancelledBy == "driver"
        )
      );

      allow delete: if false;
    }

    match /schoolReplacementOffers/{offerId} {
      // Only the affected parent ever reads their own offers — this
      // document exists purely to drive their own review screen.
      // `resource == null` guard: fetchReplacementOfferByBookingId /
      // fetchReplacementOffer (schoolTripsLib.ts) can be called for a
      // booking that was never actually driver-cancelled, i.e. no offer
      // doc exists — same dereference-on-null pitfall fixed on
      // tripLocations above, caught here during the same review.
      allow read: if isSignedIn() && (resource == null || resource.data.parentId == request.auth.uid);

      // Only the onSchoolTripCancelled Cloud Function creates these (Admin
      // SDK, bypasses these rules regardless) — no client ever creates one
      // directly.
      allow create: if false;

      // The owning parent accepts or declines — nothing else about the
      // offer (candidateTripIds, seatsNeeded, the original booking/trip it
      // points at) is ever client-editable.
      allow update: if isSignedIn() &&
        resource.data.parentId == request.auth.uid &&
        request.resource.data.parentId == resource.data.parentId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "acceptedTripId", "acceptedBookingId", "updatedAt"]) &&
        request.resource.data.status in ["accepted", "declined"];

      allow delete: if false;
    }

    // -----------------------------------------------------------------
    // tripLocations/{targetId} — the driver's live GPS during an active
    // trip. Deliberately its OWN collection, never a field on the public/
    // searchable schoolTrips doc or the wide-open bookings doc — those
    // documents are readable far more broadly than "the assigned driver and
    // passenger" (schoolTrips is publicly searchable; bookings is
    // any-signed-in-user today), so real-time GPS could never be locked
    // down to just the two people on that exact trip if it lived there.
    //
    // targetId is the bookingId for Personal Ride (one driver, one
    // passenger, both known at doc-creation time), or the tripId for School
    // Trips (one shared car, so passengers accumulate into
    // authorizedPassengerIds as their own bookings verify+start — see
    // verifyPassengerCodeAndStartTrip in schoolTripsLib.ts).
    // -----------------------------------------------------------------
    match /tripLocations/{targetId} {
      // `resource` is null for a document that doesn't exist yet — every
      // trip/booking has one of these BEFORE tracking ever starts (driver
      // hasn't arrived/been verified yet), and ride-navigation.tsx /
      // live-tracking.tsx both subscribe to this path the moment their
      // screen opens, regardless of trip status. Dereferencing
      // resource.data without checking existence first throws a rules
      // evaluation error — which Firestore reports to the client as the
      // same generic "Missing or insufficient permissions" as a real
      // denial — for EVERY signed-in user, including the legitimate
      // driver/passenger. Allowing the not-yet-created case through (there
      // is nothing to protect on a document with no data) is what actually
      // fixes this; the client already renders "no location yet" for a
      // missing snapshot either way.
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.driverId == request.auth.uid ||
        resource.data.get("passengerId", null) == request.auth.uid ||
        request.auth.uid in resource.data.get("authorizedPassengerIds", [])
      );

      // Only the assigned driver ever creates this doc — Personal Ride when
      // their own tracking starts (app/driverLocationTask.ts), School Trips
      // inside the verify-and-start transaction. Never seeded with
      // coordinates on create; a passenger can never create one.
      allow create: if isSignedIn() &&
        request.resource.data.driverId == request.auth.uid &&
        !("latitude" in request.resource.data) &&
        !("longitude" in request.resource.data);

      allow update: if isSignedIn() && resource.data.driverId == request.auth.uid && (
        // The driver's own GPS ticks — coordinates only, ownership frozen,
        // and only for the trip they actually own.
        (
          request.resource.data.driverId == resource.data.driverId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["latitude", "longitude", "heading", "speed", "accuracy", "updatedAt"])
        ) ||
        // School Trips only — authorizing exactly one more verified
        // passenger to read this trip's shared location. Grows the list by
        // exactly one entry, touches nothing else.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["authorizedPassengerIds", "updatedAt"]) &&
          request.resource.data.authorizedPassengerIds.size() ==
            resource.data.get("authorizedPassengerIds", []).size() + 1
        )
      );

      allow delete: if false;
    }

    // -----------------------------------------------------------------
    // passengerLocations/{targetId} — the passenger's own live GPS while
    // waiting for their assigned driver, in the opposite direction of
    // tripLocations above (see app/passengerLocationTask.ts). targetId is
    // the same bookingId tripLocations uses for Personal Ride/legacy
    // School, so both collections key off the same document identity for a
    // given ride. Replaces the old manually-saved pickup-coordinate fields
    // on the booking doc itself, which are read-only backward-compat now
    // (see bookingsLib.ts's pickupCoords normalization) and never written
    // by any current screen.
    // -----------------------------------------------------------------
    match /passengerLocations/{targetId} {
      // Same not-yet-created reasoning as tripLocations above — both
      // ride-navigation.tsx and the passenger's own starter effect
      // (app/(tabs)/bookings.tsx) subscribe to / may create this path the
      // moment their screen opens, before any fix has ever been written.
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.passengerId == request.auth.uid ||
        resource.data.get("driverId", null) == request.auth.uid
      );

      // Only the passenger themselves ever creates/updates this doc — the
      // assigned driver only ever reads it, never writes it.
      allow create: if isSignedIn() &&
        request.resource.data.passengerId == request.auth.uid;

      allow update: if isSignedIn() &&
        resource.data.passengerId == request.auth.uid &&
        request.resource.data.passengerId == resource.data.passengerId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["driverId", "latitude", "longitude", "heading", "speed", "accuracy", "updatedAt"]);

      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // schoolChildren/{childId} + schoolChildCodes/{codeHash} — Phase 1 of
    // the School Return Kiosk project (see AGENTS.md's kiosk audit). A
    // durable per-child profile owned by exactly one parent, carrying that
    // child's own permanent School Return lookup code. Deliberately
    // stricter than the wide-open collections above and even than
    // schoolTrips/schoolBookings: NOTHING here is ever readable by anyone
    // other than the owning parent — not the driver, not another signed-in
    // user, and (until a later phase adds a dedicated server-only lookup
    // endpoint) never an unauthenticated School Kiosk request either. See
    // app/booking/school/schoolChildrenLib.ts.
    //
    // HARDENING: a 6-digit return code is a space of only 1,000,000 values —
    // small enough that an authenticated attacker could precompute the
    // SHA-256 hash of every possible code offline and simply check which
    // schoolChildCodes docs exist. A client-readable ledger (even one
    // holding only hashes) would hand them exactly that oracle.
    // Permanent-code generation and the entire schoolChildCodes ledger are
    // therefore server-only: createSchoolChildProfile /
    // resetSchoolChildReturnCode run on the Cloudflare Worker
    // (cloudflare-worker/src/schoolChildren.ts — NOT a Firebase Cloud
    // Function; this project's Firebase plan is Spark, which can't deploy
    // those), authenticating to Firestore via the REST API with a Google
    // Cloud service account (cloudflare-worker/src/firestoreRest.ts), which
    // bypasses these rules entirely, same as the Admin SDK would. No
    // client, however authenticated, may read, create, update, or delete a
    // schoolChildCodes document, and a client may no longer directly create
    // a schoolChildren document either (see below).
    // ---------------------------------------------------------------

    match /schoolChildren/{childId} {
      // Owner-only read — no driver, no other passenger, no unauthenticated
      // kiosk request. A future kiosk lookup endpoint reads this via the
      // same service-account REST access (bypasses these rules entirely),
      // never via a client-granted read — see this collection's own header
      // comment.
      allow read: if isSignedIn() && resource.data.parentId == request.auth.uid;

      // Creation is server-only now (createSchoolChildProfile generates and
      // reserves the return code — see this match block's header comment).
      // The Worker's service-account access bypasses this rule regardless;
      // this `false` only blocks a client from ever creating the document
      // directly (which would have no way to safely mint/reserve a return
      // code anyway).
      allow create: if false;

      // Two, and only two, legitimate CLIENT update shapes — a client can
      // never touch returnCode/returnCodeHash (that only ever happens
      // inside resetSchoolChildReturnCode, server-side on the Worker, which
      // is not subject to this rule):
      //   1) Edit childName and/or schoolId, plus schoolId's optional
      //      stable-data snapshot (schoolName/schoolCityId/schoolCityName/
      //      schoolAddress — see schoolChildrenLib.ts's UpdateSchoolChildInput).
      //      Those four are plain descriptive strings, not identity/security
      //      fields, so only their type is checked, never non-emptiness. The
      //      Edit Child form (my-children.tsx) sends childName ALONE
      //      whenever the parent never touched the City/School fields this
      //      session — never forcing a reselect of an unchanged school — so
      //      this shape's own field checks (childName/schoolId is
      //      string/non-empty) always read against request.resource.data,
      //      the full RESULTING document after the merge, which still holds
      //      the existing valid schoolId even when this update's diff never
      //      touched it.
      //   2) Toggle active (deactivate/restore) — see "prefer active:
      //      false over deleting" in schoolChildrenLib.ts; never a hard
      //      delete, since a historical booking may already reference this
      //      childId.
      // parentId and createdAt are immutable under both shapes.
      allow update: if isSignedIn() &&
        resource.data.parentId == request.auth.uid &&
        request.resource.data.parentId == resource.data.parentId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        (
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                "childName", "schoolId", "schoolName", "schoolCityId",
                "schoolCityName", "schoolAddress", "updatedAt"
              ]) &&
            request.resource.data.childName is string &&
            request.resource.data.childName.size() > 0 &&
            request.resource.data.childName.size() <= 80 &&
            request.resource.data.schoolId is string &&
            request.resource.data.schoolId.size() > 0 &&
            (!("schoolName" in request.resource.data) || request.resource.data.schoolName is string) &&
            (!("schoolCityId" in request.resource.data) || request.resource.data.schoolCityId is string) &&
            (!("schoolCityName" in request.resource.data) || request.resource.data.schoolCityName is string) &&
            (!("schoolAddress" in request.resource.data) || request.resource.data.schoolAddress is string)
          ) ||
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["active", "updatedAt"]) &&
            request.resource.data.active is bool
          )
        );

      // Never a hard delete (see shape 2 above) — deactivate via active:
      // false instead.
      allow delete: if false;
    }

    // -----------------------------------------------------------------
    // savedLocations/{locationId} — a passenger's Home + named saved pickup
    // places (see app/booking/savedLocationsLib.ts), feeding the shared
    // PickupLocationPicker.tsx bottom sheet. Purely owner-data, no secret
    // fields (unlike schoolChildren's server-only return code above), so a
    // plain client-owned CRUD shape is enough — no field-shape lockdown
    // needed on update, every field here is freely user-editable.
    // "At most one isHome:true per user" is enforced client-side only (see
    // savedLocationsLib.ts's clearExistingHome), same trust boundary this
    // app already accepts for every other cross-document invariant.
    // -----------------------------------------------------------------
    match /savedLocations/{locationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;

      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Uniqueness ledger — server-only, full stop. Never readable or
    // writable by ANY client request, signed in or not (see this match
    // block's header comment for why even a read would be dangerous for a
    // 6-digit code space). Only the Cloudflare Worker's
    // createSchoolChildProfile / resetSchoolChildReturnCode routes, via
    // their service-account Firestore REST access, ever touch this
    // collection.
    match /schoolChildCodes/{codeHash} {
      allow read: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /rideRequests/{requestId} {
      // Any signed-in user may read — NOT just the requesting parent.
      // matchRideRequestsForNewTrip (schoolTripsLib.ts) runs client-side, on
      // the DRIVER'S device, immediately after a return trip is published,
      // and has to query every waiting request for that school/date across
      // ALL parents to notify the matching ones. The Cloud Function
      // equivalent (functions/index.js) uses the Admin SDK and is not
      // subject to these rules either way, but the client-side path is what
      // makes matching actually run without a separate Cloud Functions
      // deployment — see that function's own comment. This is the same
      // trust level already given to bookings/driverRoutes/notifications
      // elsewhere in this file, not a new gap.
      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
        request.resource.data.parentId == request.auth.uid &&
        request.resource.data.status == "waiting";

      allow update: if isSignedIn() && (
        // The owning parent cancels their own request, or the client marks
        // it expired once its date/time has passed (see
        // subscribeMyRideRequests in schoolTripsLib.ts).
        (
          resource.data.parentId == request.auth.uid &&
          request.resource.data.parentId == resource.data.parentId &&
          request.resource.data.status in ["cancelled", "expired"] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
        ) ||
        // ANY signed-in user (the driver whose new trip just matched this
        // waiting request) may record that match — status may only move
        // waiting → matched, parentId/school/destination/seats are
        // untouched, and only the matching-tracking fields change. Written
        // by matchRideRequestsForNewTrip client-side, or by the Cloud
        // Function (which bypasses rules regardless).
        (
          resource.data.status == "waiting" &&
          request.resource.data.status == "matched" &&
          request.resource.data.parentId == resource.data.parentId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "matchedTripId", "matchedTripIds", "notifiedTripIds", "lastNotifiedAt", "updatedAt"])
        ) ||
        // The owning parent hides this request from their own My Bookings
        // view only (hideRideRequest/"Clear All" — see schoolTripsLib.ts's
        // RideRequest.hiddenForParent) — a PURE view-hide, never a
        // cancellation: status is explicitly required to stay unchanged, so
        // the matching system keeps treating this request exactly as before.
        (
          resource.data.parentId == request.auth.uid &&
          request.resource.data.parentId == resource.data.parentId &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["hiddenForParent", "updatedAt"]) &&
          request.resource.data.hiddenForParent is bool
        ) ||
        // The owning parent actually confirms + pays for a real return
        // booking that fulfils this request (bookReturnForChild's
        // post-booking write-back — see schoolTripsLib.ts) — a real request
        // may move to "booked" from either "waiting" (booked directly,
        // never having been machine-matched) or "matched". Only the
        // matching-tracking fields may additionally change in the same
        // write; parentId/school/destination/seats stay frozen.
        (
          resource.data.parentId == request.auth.uid &&
          request.resource.data.parentId == resource.data.parentId &&
          resource.data.status in ["waiting", "matched"] &&
          request.resource.data.status == "booked" &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "matchedBookingId", "matchedTripId", "updatedAt"]) &&
          request.resource.data.matchedBookingId is string
        )
      );

      allow delete: if false;
    }
  }
}
