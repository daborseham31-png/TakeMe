# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# gemini-flash-lite-latest is Google's self-updating alias for their
# current lightweight multimodal (vision) model, and is free-tier eligible.
# Confirmed working live on 2026-07-09 — Google renames/retires models over
# time, so if this ever 404s, run:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY"
# to see what's currently available for your key.
GEMINI_MODEL=gemini-flash-lite-latest

PORT=3001
