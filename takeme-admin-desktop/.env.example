# Copy this file to .env (this project's root, takeme-admin-desktop/).
# Restart the dev server (or rebuild) after changing this file.
#
# Same backend the mobile app's School Kiosk Links screen uses (see the
# mobile app's own .env.example) — the deployed Cloudflare Worker
# (cloudflare-worker/), not a local server. Only used to build the
# per-school kiosk URLs shown on the School Kiosk Links admin screen.
EXPO_PUBLIC_BACKEND_URL=https://takeme-id-reader.yvcstudent4.workers.dev
